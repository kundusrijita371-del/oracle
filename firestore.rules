rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write all documents inside their own user path
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read and write their top-level user profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
